# Hermes Agent Configuration
# Copy this file to .env and fill in your API keys

# AI Model API Keys (at least one is required)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Messaging Platform Tokens (configure based on which platforms you want to use)
TELEGRAM_BOT_TOKEN=""
DISCORD_BOT_TOKEN=""
SLACK_BOT_TOKEN=""

# Dashboard Basic Auth (required when dashboard host is not localhost)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME="admin"
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=""

# More here: https://hermes-agent.nousresearch.com/docs/reference/environment-variables?_highlight=enviro
